{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@qline/policy": ["packages/policy/src/index.ts"],
      "@qline/ai": ["packages/ai/src/index.ts"],
      "@qline/schema": ["packages/schema/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "services/api/src/**/*.ts", "services/api/test/**/*.ts", "packages/*/test/**/*.ts"]
}
