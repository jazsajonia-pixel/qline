<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Qline starts on its dark canvas in both system modes so there is no white flash before Flutter draws. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/qline_bg</item>
        <item name="android:navigationBarColor">@color/qline_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/qline_bg</item>
    </style>
</resources>
