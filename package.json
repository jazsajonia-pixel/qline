    "better-auth": "1.7.25",
    "exceljs": "4.4.0",
    "hono": "4.13.18",
    "mammoth": "1.13.0",
    "papaparse": "5.7.1",
    "pg": "8.23.1",
    "unpdf": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.15.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vitest": "5.1.0"
  },
